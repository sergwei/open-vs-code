{
  "name": "open-vs-code",
  "displayName": "open-vs-code",
  "description": "A mouse-friendly graphical interface for opencode inside VS Code.",
  "version": "0.0.1",
  "publisher": "sergwei",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergwei/open-vs-code"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openVsCode",
          "title": "OpenCode",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "openVsCode": [
        {
          "type": "webview",
          "id": "openVsCode.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "openVsCode.opencodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the opencode **v2** executable. Leave empty to search `PATH` for `opencode2`, then `opencode`."
        }
      }
    },
    "commands": [
      {
        "command": "openVsCode.showLogs",
        "title": "Show Logs",
        "category": "OpenCode"
      }
    ]
  },
  "scripts": {
    "check-types": "run-p \"check-types:*\"",
    "check-types:host": "tsc --noEmit",
    "check-types:shared": "tsc --noEmit -p src/shared",
    "check-types:integration": "tsc --noEmit -p test/integration",
    "build": "run-s check-types \"build:*\"",
    "build:host": "node esbuild.mjs",
    "watch": "run-p \"watch:*\"",
    "watch:host": "node esbuild.mjs --watch",
    "watch:types": "tsc --noEmit --watch",
    "package": "run-s check-types lint \"package:*\"",
    "package:host": "node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies --skip-license",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:integration": "esbuild \"test/integration/**/*.test.ts\" --bundle --platform=node --format=cjs --target=node22 --sourcemap --external:vscode --outdir=out/test/integration",
    "test:integration": "run-s build:host build:webview compile:integration && vscode-test",
    "build:webview": "node webview-ui/build.mjs",
    "package:webview": "node webview-ui/build.mjs --production",
    "watch:webview": "node webview-ui/build.mjs --watch",
    "check-types:webview": "tsc --noEmit -p webview-ui && tsc --noEmit -p webview-ui/tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.105.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.10",
    "solid-js": "~1.9.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "~8.3.4",
    "vite-plugin-solid": "~2.11.14",
    "vitest": "5.0.5"
  }
}

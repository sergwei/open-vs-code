{
  "name": "open-vs-code",
  "displayName": "OpenCode Station",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "sergwei",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Sergio González Carbajal"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1d33",
    "theme": "dark"
  },
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "coding agent",
    "chat",
    "assistant",
    "llm",
    "gui",
    "mouse",
    "sessions",
    "permissions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sergwei/open-vs-code"
  },
  "bugs": {
    "url": "https://github.com/sergwei/open-vs-code/issues"
  },
  "homepage": "https://github.com/sergwei/open-vs-code#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onWebviewPanel:openVsCode.chatPanel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openVsCode",
          "title": "OpenCode",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "openVsCode": [
        {
          "type": "webview",
          "id": "openVsCode.chat",
          "name": "%view.chat.name%",
          "when": "config.openVsCode.chatLocation == sidebar"
        },
        {
          "id": "openVsCode.sessions",
          "name": "%view.sessions.name%",
          "when": "config.openVsCode.chatLocation != sidebar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openVsCode.sessions",
        "contents": "%viewsWelcome.sessions.ready%",
        "when": "openVsCode.sessionsState == ready"
      },
      {
        "view": "openVsCode.sessions",
        "contents": "%viewsWelcome.sessions.offline%",
        "when": "openVsCode.sessionsState == offline"
      },
      {
        "view": "openVsCode.sessions",
        "contents": "%viewsWelcome.sessions.noFolder%",
        "when": "openVsCode.sessionsState == noFolder"
      },
      {
        "view": "openVsCode.sessions",
        "contents": "%viewsWelcome.sessions.filteredEmpty%",
        "when": "openVsCode.sessionsState == filteredEmpty"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "openVsCode.opencodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 1,
          "markdownDescription": "%config.opencodePath.markdownDescription%"
        },
        "openVsCode.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^\\s*$|^\\s*[hH][tT][tT][pP][sS]?://",
          "patternErrorMessage": "%config.serverUrl.patternErrorMessage%",
          "order": 2,
          "markdownDescription": "%config.serverUrl.markdownDescription%"
        },
        "openVsCode.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 3,
          "markdownDescription": "%config.defaultModel.markdownDescription%"
        },
        "openVsCode.chatLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "%config.chatLocation.enumDescriptions.sidebar%",
            "%config.chatLocation.enumDescriptions.editor%"
          ],
          "default": "editor",
          "scope": "window",
          "order": 4,
          "markdownDescription": "%config.chatLocation.markdownDescription%"
        },
        "openVsCode.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 5,
          "markdownDescription": "%config.autoStart.markdownDescription%"
        },
        "openVsCode.mods.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 6,
          "markdownDescription": "%config.mods.enabled.markdownDescription%"
        }
      }
    },
    "commands": [
      {
        "command": "openVsCode.manageMods",
        "title": "%command.manageMods.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.reloadMods",
        "title": "%command.reloadMods.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.openModsFolder",
        "title": "%command.openModsFolder.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.runModCommand",
        "title": "%command.runModCommand.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.showLogs",
        "title": "%command.showLogs.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.restartServer",
        "title": "%command.restartServer.title%",
        "category": "OpenCode",
        "icon": "$(debug-restart)"
      },
      {
        "command": "openVsCode.selectFolder",
        "title": "%command.selectFolder.title%",
        "category": "OpenCode",
        "enablement": "workspaceFolderCount > 1"
      },
      {
        "command": "openVsCode.managePermissions",
        "title": "%command.managePermissions.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.setServerPassword",
        "title": "%command.setServerPassword.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.clearServerPassword",
        "title": "%command.clearServerPassword.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.forgetPluginDecision",
        "title": "%command.forgetPluginDecision.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.addToChat",
        "title": "%command.addToChat.title%"
      },
      {
        "command": "openVsCode.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%"
      },
      {
        "command": "openVsCode.explainSelection",
        "title": "%command.explainSelection.title%"
      },
      {
        "command": "openVsCode.fixSelection",
        "title": "%command.fixSelection.title%"
      },
      {
        "command": "openVsCode.explainFiles",
        "title": "%command.explainFiles.title%"
      },
      {
        "command": "openVsCode.openChat",
        "title": "%command.openChat.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.focusPrompt",
        "title": "%command.focusPrompt.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.newSession",
        "title": "%command.newSession.title%",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "openVsCode.openServerSettings",
        "title": "%command.openServerSettings.title%",
        "category": "OpenCode",
        "icon": "$(gear)"
      },
      {
        "command": "openVsCode.openSettings",
        "title": "%command.openSettings.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.stopResponse",
        "title": "%command.stopResponse.title%",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.renameSession",
        "title": "%command.renameSession.title%",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "openVsCode.deleteSession",
        "title": "%command.deleteSession.title%",
        "category": "OpenCode",
        "icon": "$(trash)"
      },
      {
        "command": "openVsCode.searchSessions",
        "title": "%command.searchSessions.title%",
        "category": "OpenCode",
        "icon": "$(search)"
      },
      {
        "command": "openVsCode.newFolder",
        "title": "%command.newFolder.title%",
        "category": "OpenCode",
        "icon": "$(new-folder)"
      },
      {
        "command": "openVsCode.newSubfolder",
        "title": "%command.newSubfolder.title%",
        "category": "OpenCode",
        "icon": "$(new-folder)"
      },
      {
        "command": "openVsCode.renameFolder",
        "title": "%command.renameFolder.title%",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "openVsCode.deleteFolder",
        "title": "%command.deleteFolder.title%",
        "category": "OpenCode",
        "icon": "$(trash)"
      },
      {
        "command": "openVsCode.moveToFolder",
        "title": "%command.moveToFolder.title%",
        "category": "OpenCode",
        "icon": "$(folder-active)"
      },
      {
        "command": "openVsCode.pinSession",
        "title": "%command.pinSession.title%",
        "category": "OpenCode",
        "icon": "$(pin)"
      },
      {
        "command": "openVsCode.unpinSession",
        "title": "%command.unpinSession.title%",
        "category": "OpenCode",
        "icon": "$(pinned)"
      },
      {
        "command": "openVsCode.archiveSession",
        "title": "%command.archiveSession.title%",
        "category": "OpenCode",
        "icon": "$(archive)"
      },
      {
        "command": "openVsCode.unarchiveSession",
        "title": "%command.unarchiveSession.title%",
        "category": "OpenCode",
        "icon": "$(archive)"
      },
      {
        "command": "openVsCode.filterSessions",
        "title": "%command.filterSessions.title%",
        "category": "OpenCode",
        "icon": "$(filter)"
      },
      {
        "command": "openVsCode.clearFilters",
        "title": "%command.clearFilters.title%",
        "category": "OpenCode",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "openVsCode.focusPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus",
        "args": {
          "to": "chat"
        }
      },
      {
        "command": "openVsCode.focusPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "openVsCode.chatFocused && !editorTextFocus",
        "args": {
          "to": "editor"
        }
      },
      {
        "command": "openVsCode.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "openVsCode.chatFocused"
      },
      {
        "command": "openVsCode.renameSession",
        "key": "f2",
        "mac": "f2",
        "when": "focusedView == openVsCode.sessions && !inputFocus"
      },
      {
        "command": "openVsCode.deleteSession",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == openVsCode.sessions && !inputFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openVsCode.openServerSettings",
          "group": "navigation",
          "when": "view == openVsCode.chat"
        },
        {
          "command": "openVsCode.restartServer",
          "group": "9_server",
          "when": "view == openVsCode.chat"
        },
        {
          "command": "openVsCode.newSession",
          "group": "navigation@1",
          "when": "view == openVsCode.sessions"
        },
        {
          "command": "openVsCode.searchSessions",
          "group": "navigation@2",
          "when": "view == openVsCode.sessions"
        },
        {
          "command": "openVsCode.filterSessions",
          "group": "navigation@3",
          "when": "view == openVsCode.sessions"
        },
        {
          "command": "openVsCode.clearFilters",
          "group": "navigation@4",
          "when": "view == openVsCode.sessions && openVsCode.sessionsFiltered"
        },
        {
          "command": "openVsCode.openServerSettings",
          "group": "navigation@5",
          "when": "view == openVsCode.sessions"
        },
        {
          "command": "openVsCode.newFolder",
          "group": "2_organize",
          "when": "view == openVsCode.sessions"
        },
        {
          "command": "openVsCode.restartServer",
          "group": "9_server",
          "when": "view == openVsCode.sessions"
        }
      ],
      "view/item/context": [
        {
          "command": "openVsCode.renameSession",
          "group": "inline@1",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/"
        },
        {
          "command": "openVsCode.deleteSession",
          "group": "inline@2",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/"
        },
        {
          "command": "openVsCode.pinSession",
          "group": "0_organize@1",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /^(?!.*\\b(pinned|archived)\\b)/"
        },
        {
          "command": "openVsCode.unpinSession",
          "group": "0_organize@1",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bpinned\\b/"
        },
        {
          "command": "openVsCode.moveToFolder",
          "group": "0_organize@2",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/"
        },
        {
          "command": "openVsCode.archiveSession",
          "group": "0_organize@3",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /^(?!.*\\barchived\\b)/"
        },
        {
          "command": "openVsCode.unarchiveSession",
          "group": "0_organize@3",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\barchived\\b/"
        },
        {
          "command": "openVsCode.renameSession",
          "group": "1_modification@1",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/"
        },
        {
          "command": "openVsCode.deleteSession",
          "group": "1_modification@2",
          "when": "view == openVsCode.sessions && viewItem =~ /\\bsession\\b/"
        },
        {
          "command": "openVsCode.newSubfolder",
          "group": "0_organize@1",
          "when": "view == openVsCode.sessions && viewItem == folder"
        },
        {
          "command": "openVsCode.renameFolder",
          "group": "1_modification@1",
          "when": "view == openVsCode.sessions && viewItem == folder"
        },
        {
          "command": "openVsCode.deleteFolder",
          "group": "1_modification@2",
          "when": "view == openVsCode.sessions && viewItem == folder"
        }
      ],
      "explorer/context": [
        {
          "command": "openVsCode.addToChat",
          "group": "6_copypath@99",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.explainFiles",
          "group": "6_copypath@100",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "openVsCode.addSelectionToChat",
          "group": "openVsCode@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.explainSelection",
          "group": "openVsCode@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.fixSelection",
          "group": "openVsCode@3",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "openVsCode.addToChat",
          "when": "false"
        },
        {
          "command": "openVsCode.explainFiles",
          "when": "false"
        },
        {
          "command": "openVsCode.renameSession",
          "when": "false"
        },
        {
          "command": "openVsCode.deleteSession",
          "when": "false"
        },
        {
          "command": "openVsCode.searchSessions",
          "when": "config.openVsCode.chatLocation != sidebar"
        },
        {
          "command": "openVsCode.newFolder",
          "when": "config.openVsCode.chatLocation != sidebar"
        },
        {
          "command": "openVsCode.filterSessions",
          "when": "config.openVsCode.chatLocation != sidebar"
        },
        {
          "command": "openVsCode.clearFilters",
          "when": "config.openVsCode.chatLocation != sidebar && openVsCode.sessionsFiltered"
        },
        {
          "command": "openVsCode.newSubfolder",
          "when": "false"
        },
        {
          "command": "openVsCode.renameFolder",
          "when": "false"
        },
        {
          "command": "openVsCode.deleteFolder",
          "when": "false"
        },
        {
          "command": "openVsCode.moveToFolder",
          "when": "false"
        },
        {
          "command": "openVsCode.pinSession",
          "when": "false"
        },
        {
          "command": "openVsCode.unpinSession",
          "when": "false"
        },
        {
          "command": "openVsCode.archiveSession",
          "when": "false"
        },
        {
          "command": "openVsCode.unarchiveSession",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "check-types": "run-p \"check-types:*\"",
    "check-types:host": "tsc --noEmit",
    "check-types:shared": "tsc --noEmit -p src/shared",
    "check-types:integration": "tsc --noEmit -p test/integration",
    "build": "run-s check-types \"build:*\"",
    "build:host": "node esbuild.mjs",
    "watch": "run-p \"watch:*\"",
    "watch:host": "node esbuild.mjs --watch",
    "watch:types": "tsc --noEmit --watch",
    "package": "run-s check-types lint \"package:*\"",
    "package:host": "node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "l10n:export": "node scripts/l10n.mjs export",
    "l10n:check": "node scripts/l10n.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:integration": "esbuild \"test/integration/**/*.test.ts\" --bundle --platform=node --format=cjs --target=node22 --sourcemap --external:vscode --outdir=out/test/integration",
    "test:integration": "run-s build:host build:webview compile:integration && vscode-test",
    "test:visual": "run-s build:host build:webview && node test/visual/run.mjs",
    "test:event-shapes": "vitest run --config vitest.contract.config.mts",
    "build:webview": "node webview-ui/build.mjs",
    "package:webview": "node webview-ui/build.mjs --production",
    "watch:webview": "node webview-ui/build.mjs --watch",
    "check-types:webview": "tsc --noEmit -p webview-ui && tsc --noEmit -p webview-ui/tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/client": "2.0.32",
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.105.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/l10n": "0.0.18",
    "@vscode/l10n-dev": "0.0.35",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "dompurify": "~3.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "highlight.js": "~11.12.0",
    "jsdom": "~30.1.3",
    "jsonc-parser": "3.3.1",
    "marked": "18.0.11",
    "npm-run-all2": "^9.0.3",
    "ovsx": "1.3.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10",
    "remend": "1.3.1",
    "solid-js": "~1.9.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "~8.3.4",
    "vite-plugin-solid": "~2.11.14",
    "vitest": "5.0.5"
  }
}

{
  "name": "open-vs-code",
  "displayName": "OpenCode GUI",
  "description": "A mouse-friendly chat interface for opencode, an unofficial client of its local server.",
  "version": "0.0.1",
  "publisher": "sergwei",
  "license": "MIT",
  "author": {
    "name": "Sergio González Carbajal"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1d33",
    "theme": "dark"
  },
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "coding agent",
    "chat",
    "assistant",
    "llm",
    "gui",
    "mouse",
    "sessions",
    "permissions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sergwei/open-vs-code"
  },
  "bugs": {
    "url": "https://github.com/sergwei/open-vs-code/issues"
  },
  "homepage": "https://github.com/sergwei/open-vs-code#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "opencode can run commands and tools defined by the project, such as slash commands with !`cmd` in .opencode/command, with the permissions of your user. Trust the folder before using this extension."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openVsCode",
          "title": "OpenCode",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "openVsCode": [
        {
          "type": "webview",
          "id": "openVsCode.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "openVsCode.opencodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 1,
          "markdownDescription": "Absolute path to the opencode **v2** executable. Leave empty to search `PATH` for `opencode2`, then `opencode`. On Windows an npm shim (`opencode.cmd`) is accepted and the executable it wraps is launched. Not used while `#openVsCode.serverUrl#` is set. A change applies without reloading the window."
        },
        "openVsCode.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^\\s*$|^\\s*[hH][tT][tT][pP][sS]?://",
          "patternErrorMessage": "Write the address of a server on this machine, like http://127.0.0.1:4096.",
          "order": 2,
          "markdownDescription": "Address of an opencode **v2** server that is already running on **this machine**, for example `http://127.0.0.1:4096` (`127.0.0.1`, `[::1]` and `localhost` are accepted, over `http` or `https`). When set, the extension does **not** launch its own server and `#openVsCode.opencodePath#` is not used. Its password is not a setting: run **OpenCode: Set Server Password** (the user is always `opencode`). Leave empty to let the extension launch its own server."
        },
        "openVsCode.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 3,
          "markdownDescription": "Model that every **new** chat session starts with, written `provider/model` (for example `opencode/big-pickle`). It wins over the last model you sent a prompt with. Leave empty to start with that last model, or with opencode's own default if there is none. A value that is badly written or not offered by the server is ignored with a warning."
        }
      }
    },
    "commands": [
      {
        "command": "openVsCode.showLogs",
        "title": "Show Logs",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.restartServer",
        "title": "Restart Server",
        "category": "OpenCode",
        "icon": "$(debug-restart)"
      },
      {
        "command": "openVsCode.selectFolder",
        "title": "Select Workspace Folder",
        "category": "OpenCode",
        "enablement": "workspaceFolderCount > 1"
      },
      {
        "command": "openVsCode.managePermissions",
        "title": "Manage Saved Permissions",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.setServerPassword",
        "title": "Set Server Password",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.clearServerPassword",
        "title": "Forget Server Password",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.addToChat",
        "title": "Add to OpenCode Chat"
      },
      {
        "command": "openVsCode.addSelectionToChat",
        "title": "Add to OpenCode Chat"
      },
      {
        "command": "openVsCode.explainSelection",
        "title": "Explain with OpenCode"
      },
      {
        "command": "openVsCode.fixSelection",
        "title": "Fix with OpenCode"
      },
      {
        "command": "openVsCode.explainFiles",
        "title": "Explain with OpenCode"
      },
      {
        "command": "openVsCode.openChat",
        "title": "Open Chat",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.focusPrompt",
        "title": "Focus Prompt",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.newSession",
        "title": "New Session",
        "category": "OpenCode"
      },
      {
        "command": "openVsCode.stopResponse",
        "title": "Stop Response",
        "category": "OpenCode"
      }
    ],
    "keybindings": [
      {
        "command": "openVsCode.focusPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus",
        "args": {
          "to": "chat"
        }
      },
      {
        "command": "openVsCode.focusPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "openVsCode.chatFocused && !editorTextFocus",
        "args": {
          "to": "editor"
        }
      },
      {
        "command": "openVsCode.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "openVsCode.chatFocused"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openVsCode.restartServer",
          "group": "navigation",
          "when": "view == openVsCode.chat"
        }
      ],
      "explorer/context": [
        {
          "command": "openVsCode.addToChat",
          "group": "6_copypath@99",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.explainFiles",
          "group": "6_copypath@100",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "openVsCode.addSelectionToChat",
          "group": "openVsCode@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.explainSelection",
          "group": "openVsCode@2",
          "when": "resourceScheme == file"
        },
        {
          "command": "openVsCode.fixSelection",
          "group": "openVsCode@3",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "openVsCode.addToChat",
          "when": "false"
        },
        {
          "command": "openVsCode.explainFiles",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "check-types": "run-p \"check-types:*\"",
    "check-types:host": "tsc --noEmit",
    "check-types:shared": "tsc --noEmit -p src/shared",
    "check-types:integration": "tsc --noEmit -p test/integration",
    "build": "run-s check-types \"build:*\"",
    "build:host": "node esbuild.mjs",
    "watch": "run-p \"watch:*\"",
    "watch:host": "node esbuild.mjs --watch",
    "watch:types": "tsc --noEmit --watch",
    "package": "run-s check-types lint \"package:*\"",
    "package:host": "node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:integration": "esbuild \"test/integration/**/*.test.ts\" --bundle --platform=node --format=cjs --target=node22 --sourcemap --external:vscode --outdir=out/test/integration",
    "test:integration": "run-s build:host build:webview compile:integration && vscode-test",
    "test:visual": "run-s build:host build:webview && node test/visual/run.mjs",
    "test:event-shapes": "vitest run --config vitest.contract.config.mts",
    "build:webview": "node webview-ui/build.mjs",
    "package:webview": "node webview-ui/build.mjs --production",
    "watch:webview": "node webview-ui/build.mjs --watch",
    "check-types:webview": "tsc --noEmit -p webview-ui && tsc --noEmit -p webview-ui/tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/client": "2.0.32",
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.105.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "dompurify": "~3.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "highlight.js": "~11.12.0",
    "jsdom": "~30.1.3",
    "marked": "18.0.11",
    "npm-run-all2": "^9.0.3",
    "ovsx": "1.3.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10",
    "remend": "1.3.1",
    "solid-js": "~1.9.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "~8.3.4",
    "vite-plugin-solid": "~2.11.14",
    "vitest": "5.0.5"
  }
}
